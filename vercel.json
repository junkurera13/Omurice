{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s/:score/:name",
      "destination": "/api/share?s=:score&n=:name"
    }
  ]
}
